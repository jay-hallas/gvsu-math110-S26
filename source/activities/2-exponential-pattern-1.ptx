<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="activity-linear-exponential-patterns"
  xmlns:xi="http://www.w3.org/2001/XInclude">

  <title>Activity: Linear Versus Exponential Patterns</title>

  <introduction>
    <p>
      For each of the following patterns, complete the steps below.
      <ul>
        <li><p>Draw or sketch Case 4 and Case 5 (if the number of shapes gets too large,
        just sketch the outline and write the dimensions).</p></li>
        <li><p>Complete the table.</p></li>
        <li><p>Determine whether the growth is <em>linear, exponential, or neither</em>
        and explain how you know.</p></li>
        <li><p>If linear or exponential, find an equation for the number of shapes
        (<m>y</m>) in terms of the case number (<m>n</m>).</p></li>
        <li><p>Check that your equation works by plugging in some cases from the
        table.</p></li>
      </ul>
    </p>
  </introduction>

  <page>

    <exercise xml:id="ex-pattern-exp1">
      <title>Pattern 1</title>
      <introduction>
        <figure xml:id="fig-pattern-exp1">
          <caption>
            A rectangular grid of blue squares, fixed at 3 rows tall. Case 1 has 1 column
            (3 squares), Case 2 has 2 columns (6 squares), and Case 3 has 4 columns
            (12 squares). The number of columns doubles each case.
          </caption>
          <image xml:id="img-pattern-exp1" width="90%">
            <shortdescription>
              Three completed blue square grids of heights 3 and widths 1, 2, and 4
              for Cases 1, 2, and 3, followed by two dashed empty boxes for Cases 4 and 5.
            </shortdescription>
            <latex-image>
              \begin{tikzpicture}[scale=0.34, baseline]
                \begin{scope}[shift={(0,0)}]
                  \foreach \y in {0,1,2}
                    \draw[fill=blue!60, draw=black, thick] (0,\y) rectangle ++(1,1);
                  \node at (0.5,-1.0) {Case 1};
                \end{scope}
                \begin{scope}[shift={(4.0,0)}]
                  \foreach \x in {0,1} \foreach \y in {0,1,2}
                    \draw[fill=blue!60, draw=black, thick] (\x,\y) rectangle ++(1,1);
                  \node at (1.0,-1.0) {Case 2};
                \end{scope}
                \begin{scope}[shift={(9.5,0)}]
                  \foreach \x in {0,1,2,3} \foreach \y in {0,1,2}
                    \draw[fill=blue!60, draw=black, thick] (\x,\y) rectangle ++(1,1);
                  \node at (2.0,-1.0) {Case 3};
                \end{scope}
                \begin{scope}[shift={(16.5,0)}]
                  \draw[dashed, gray] (-0.4,-0.4) rectangle (8.4,3.4);
                  \node at (4.0,-1.0) {Case 4};
                \end{scope}
                \begin{scope}[shift={(27.0,0)}]
                  \draw[dashed, gray] (-0.4,-0.4) rectangle (10.4,3.4);
                  \node at (5.0,-1.0) {Case 5};
                \end{scope}
              \end{tikzpicture}
            </latex-image>
          </image>
        </figure>
      </introduction>

      <task xml:id="ex-p1-table">
        <statement>
          <p>Complete the table.</p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell>Case (<m>n</m>)</cell>
              <cell>1</cell><cell>2</cell><cell>3</cell><cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell>Shapes</cell>
              <cell>3</cell><cell>6</cell><cell>12</cell><cell></cell><cell></cell>
            </row>
          </tabular>
        </statement>
        <answer>
          <p>24; 48.</p>
        </answer>
      </task>

      <task xml:id="ex-p1-type" workspace="1.2cm">
        <statement>
          <p>
            Is the growth <em>linear</em>, <em>exponential</em>, or <em>neither</em>?
            Circle one and explain how you know.
          </p>
          <p><em>Equation (if applicable):</em> <fillin characters="30"/></p>
        </statement>
        <answer>
          <p>Exponential (ratio 2). Equation: <m>y = 3 \cdot 2^{n-1}</m>.</p>
        </answer>
      </task>
    </exercise>

    <exercise xml:id="ex-pattern-linear">
      <title>Pattern 2</title>
      <introduction>
        <figure xml:id="fig-pattern-linear">
          <caption>
            A pattern of purple triangles. Each case has a fixed header row of 4 triangles
            on top, plus a growing block of 3 triangles wide that adds one row per case.
            Case 1 has 7 triangles total, Case 2 has 10, Case 3 has 13.
          </caption>
          <image xml:id="img-pattern-linear" width="90%">
            <shortdescription>
              Three arrangements of purple triangles for Cases 1, 2, and 3, followed by
              two dashed empty boxes for Cases 4 and 5.
            </shortdescription>
            <latex-image>
              \usetikzlibrary{shapes.geometric}
              \begin{tikzpicture}[scale=0.34, baseline]
                \begin{scope}[shift={(0,0)}]
                  \foreach \x in {0,1,2,3}
                    \node[regular polygon, regular polygon sides=3, draw=black,
                          fill=purple!60, thick, minimum size=3.5mm, inner sep=0pt]
                          at (\x+0.5,1.5) {};
                  \foreach \x in {0,1,2}
                    \node[regular polygon, regular polygon sides=3, draw=black,
                          fill=purple!60, thick, minimum size=3.5mm, inner sep=0pt]
                          at (\x+0.5,0.5) {};
                  \node at (2.0,-1.0) {Case 1};
                \end{scope}
                \begin{scope}[shift={(7.0,0)}]
                  \foreach \x in {0,1,2,3}
                    \node[regular polygon, regular polygon sides=3, draw=black,
                          fill=purple!60, thick, minimum size=3.5mm, inner sep=0pt]
                          at (\x+0.5,2.5) {};
                  \foreach \y in {0,1} \foreach \x in {0,1,2}
                    \node[regular polygon, regular polygon sides=3, draw=black,
                          fill=purple!60, thick, minimum size=3.5mm, inner sep=0pt]
                          at (\x+0.5,\y+0.5) {};
                  \node at (2.0,-1.0) {Case 2};
                \end{scope}
                \begin{scope}[shift={(14.5,0)}]
                  \foreach \x in {0,1,2,3}
                    \node[regular polygon, regular polygon sides=3, draw=black,
                          fill=purple!60, thick, minimum size=3.5mm, inner sep=0pt]
                          at (\x+0.5,3.5) {};
                  \foreach \y in {0,1,2} \foreach \x in {0,1,2}
                    \node[regular polygon, regular polygon sides=3, draw=black,
                          fill=purple!60, thick, minimum size=3.5mm, inner sep=0pt]
                          at (\x+0.5,\y+0.5) {};
                  \node at (2.0,-1.0) {Case 3};
                \end{scope}
                \begin{scope}[shift={(21.5,0)}]
                  \draw[dashed, gray] (-0.4,-0.4) rectangle (4.8,5.4);
                  \node at (2.2,-1.0) {Case 4};
                \end{scope}
                \begin{scope}[shift={(28.5,0)}]
                  \draw[dashed, gray] (-0.4,-0.4) rectangle (4.8,6.4);
                  \node at (2.2,-1.0) {Case 5};
                \end{scope}
              \end{tikzpicture}
            </latex-image>
          </image>
        </figure>
      </introduction>

      <task xml:id="ex-p2-table">
        <statement>
          <p>Complete the table.</p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell>Case (<m>n</m>)</cell>
              <cell>1</cell><cell>2</cell><cell>3</cell><cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell>Shapes</cell>
              <cell>7</cell><cell>10</cell><cell>13</cell><cell></cell><cell></cell>
            </row>
          </tabular>
        </statement>
        <answer>
          <p>16; 19.</p>
        </answer>
      </task>

      <task xml:id="ex-p2-type" workspace="1.2cm">
        <statement>
          <p>
            Is the growth <em>linear</em>, <em>exponential</em>, or <em>neither</em>?
            Circle one and explain how you know.
          </p>
          <p><em>Equation (if applicable):</em> <fillin characters="30"/></p>
        </statement>
        <answer>
          <p>Linear (constant difference of 3). Equation: <m>y = 3n + 4</m>.</p>
        </answer>
      </task>
    </exercise>

  </page>

  <page>

    <exercise xml:id="ex-pattern-exp2">
      <title>Pattern 3</title>
      <introduction>
        <figure xml:id="fig-pattern-exp2">
          <caption>
            A rectangular grid of teal circles, fixed at 3 rows tall. Case 1 has 1 column
            (3 circles), Case 2 has 3 columns (9 circles), and Case 3 has 9 columns
            (27 circles). The number of columns triples each case.
          </caption>
          <image xml:id="img-pattern-exp2" width="95%">
            <shortdescription>
              Three completed grids of teal circles with 3 rows and 1, 3, and 9 columns
              for Cases 1, 2, and 3, followed by two dashed empty wide boxes for
              Cases 4 and 5.
            </shortdescription>
            <latex-image>
              \begin{tikzpicture}[scale=0.34, baseline]
                \begin{scope}[shift={(0,0)}]
                  \foreach \y in {0,1,2}
                    \node[draw=black, circle, fill=teal!60, thick,
                          minimum size=3.5mm, inner sep=0pt] at (0.5,\y+0.5) {};
                  \node at (0.5,-1.0) {Case 1};
                \end{scope}
                \begin{scope}[shift={(4.0,0)}]
                  \foreach \x in {0,1,2} \foreach \y in {0,1,2}
                    \node[draw=black, circle, fill=teal!60, thick,
                          minimum size=3.5mm, inner sep=0pt] at (\x+0.5,\y+0.5) {};
                  \node at (1.5,-1.0) {Case 2};
                \end{scope}
                \begin{scope}[shift={(10.5,0)}]
                  \foreach \x in {0,...,8} \foreach \y in {0,1,2}
                    \node[draw=black, circle, fill=teal!60, thick,
                          minimum size=3.5mm, inner sep=0pt] at (\x+0.5,\y+0.5) {};
                  \node at (4.5,-1.0) {Case 3};
                \end{scope}
                \begin{scope}[shift={(22.5,0)}]
                  \draw[dashed, gray] (-0.4,-0.4) rectangle (10.4,3.4);
                  \node at (5.0,-1.0) {Case 4};
                \end{scope}
                \begin{scope}[shift={(35.0,0)}]
                  \draw[dashed, gray] (-0.4,-0.4) rectangle (10.4,3.4);
                  \node at (5.0,-1.0) {Case 5};
                \end{scope}
              \end{tikzpicture}
            </latex-image>
          </image>
        </figure>
      </introduction>

      <task xml:id="ex-p3-table">
        <statement>
          <p>Complete the table.</p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell>Case (<m>n</m>)</cell>
              <cell>1</cell><cell>2</cell><cell>3</cell><cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell>Shapes</cell>
              <cell>3</cell><cell>9</cell><cell>27</cell><cell></cell><cell></cell>
            </row>
          </tabular>
        </statement>
        <answer>
          <p>81; 243.</p>
        </answer>
      </task>

      <task xml:id="ex-p3-type" workspace="1.2cm">
        <statement>
          <p>
            Is the growth <em>linear</em>, <em>exponential</em>, or <em>neither</em>?
            Circle one and explain how you know.
          </p>
          <p><em>Equation (if applicable):</em> <fillin characters="30"/></p>
        </statement>
        <answer>
          <p>Exponential (ratio 3). Equation: <m>y = 3^{n}</m>.</p>
        </answer>
      </task>
    </exercise>

    <exercise xml:id="ex-pattern-quad">
      <title>Pattern 4</title>
      <introduction>
        <figure xml:id="fig-pattern-quad">
          <caption>
            A triangular staircase of brick-red hexagons. Case 1 has 1 hexagon, Case 2
            has 3 (a row of 2 with 1 above), and Case 3 has 6 (rows of 3, 2, 1 stacked
            upward).
          </caption>
          <image xml:id="img-pattern-quad" width="80%">
            <shortdescription>
              Three triangular arrangements of brick-red hexagons for Cases 1, 2, and 3,
              followed by two dashed empty boxes for Cases 4 and 5.
            </shortdescription>
            <latex-image>
              \usetikzlibrary{shapes.geometric}
              \begin{tikzpicture}[scale=0.45, baseline]
                \begin{scope}[shift={(0,0)}]
                  \node[regular polygon, regular polygon sides=6, draw=black,
                        fill=red!60, thick, minimum size=4mm, inner sep=0pt]
                        at (0.5,0.5) {};
                  \node at (0.5,-0.5) {Case 1};
                \end{scope}
                \begin{scope}[shift={(3.5,0)}]
                  \foreach \x in {0,1}
                    \node[regular polygon, regular polygon sides=6, draw=black,
                          fill=red!60, thick, minimum size=4mm, inner sep=0pt]
                          at (\x+0.5,0.5) {};
                  \node[regular polygon, regular polygon sides=6, draw=black,
                        fill=red!60, thick, minimum size=4mm, inner sep=0pt]
                        at (1.0,1.5) {};
                  \node at (1.0,-0.5) {Case 2};
                \end{scope}
                \begin{scope}[shift={(8.5,0)}]
                  \foreach \x in {0,1,2}
                    \node[regular polygon, regular polygon sides=6, draw=black,
                          fill=red!60, thick, minimum size=4mm, inner sep=0pt]
                          at (\x+0.5,0.5) {};
                  \foreach \x in {0,1}
                    \node[regular polygon, regular polygon sides=6, draw=black,
                          fill=red!60, thick, minimum size=4mm, inner sep=0pt]
                          at (\x+1.0,1.5) {};
                  \node[regular polygon, regular polygon sides=6, draw=black,
                        fill=red!60, thick, minimum size=4mm, inner sep=0pt]
                        at (1.5,2.5) {};
                  \node at (1.5,-0.5) {Case 3};
                \end{scope}
                \begin{scope}[shift={(15.0,0)}]
                  \draw[dashed, gray] (-0.2,-0.2) rectangle (4.5,4.2);
                  \node at (2.0,-0.5) {Case 4};
                \end{scope}
                \begin{scope}[shift={(21.5,0)}]
                  \draw[dashed, gray] (-0.2,-0.2) rectangle (5.5,5.2);
                  \node at (2.5,-0.5) {Case 5};
                \end{scope}
              \end{tikzpicture}
            </latex-image>
          </image>
        </figure>
      </introduction>

      <task xml:id="ex-p4-table">
        <statement>
          <p>Complete the table.</p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell>Case (<m>n</m>)</cell>
              <cell>1</cell><cell>2</cell><cell>3</cell><cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell>Shapes</cell>
              <cell>1</cell><cell>3</cell><cell>6</cell><cell></cell><cell></cell>
            </row>
          </tabular>
        </statement>
        <answer>
          <p>10; 15.</p>
        </answer>
      </task>

      <task xml:id="ex-p4-type" workspace="1.2cm">
        <statement>
          <p>
            Is the growth <em>linear</em>, <em>exponential</em>, or <em>neither</em>?
            Circle one and explain how you know.
          </p>
          <p><em>Equation (if applicable):</em> <fillin characters="30"/></p>
        </statement>
        <answer>
          <p>Neither. The differences are 2, 3, 4 (not constant) and the ratios are not
          constant either. Formula: <m>y = \dfrac{n(n+1)}{2}</m>.</p>
        </answer>
      </task>
    </exercise>

    <exercise xml:id="ex-concept-check">
      <title>Concept Check: Classifying from a Table</title>
      <introduction>
        <p>
          For each table below, fill in the missing values, classify the pattern as
          linear, exponential, or neither, and write an equation if one exists.
        </p>
      </introduction>

      <task xml:id="ex-table-a">
        <statement>
          <p><em>Table A</em></p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell><m>n</m></cell><cell>1</cell><cell>2</cell><cell>3</cell>
              <cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell><m>y</m></cell>
              <cell>4</cell><cell>12</cell><cell>36</cell><cell></cell><cell></cell>
            </row>
          </tabular>
          <p>Type: <fillin characters="18"/> <m>\quad</m> Equation: <fillin characters="22"/></p>
        </statement>
        <answer>
          <p>Exponential growth (ratio 3). <m>y = 4 \cdot 3^{n-1}</m>; values 108 and 324.</p>
        </answer>
      </task>

      <task xml:id="ex-table-b">
        <statement>
          <p><em>Table B</em></p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell><m>n</m></cell><cell>1</cell><cell>2</cell><cell>3</cell>
              <cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell><m>y</m></cell>
              <cell>30</cell><cell>24</cell><cell>18</cell><cell></cell><cell></cell>
            </row>
          </tabular>
          <p>Type: <fillin characters="18"/> <m>\quad</m> Equation: <fillin characters="22"/></p>
        </statement>
        <answer>
          <p>Linear decreasing (difference <m>-6</m>). <m>y = -6n + 36</m>; values 12 and 6.</p>
        </answer>
      </task>

      <task xml:id="ex-table-c">
        <statement>
          <p><em>Table C</em></p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell><m>n</m></cell><cell>1</cell><cell>2</cell><cell>3</cell>
              <cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell><m>y</m></cell>
              <cell>2</cell><cell>5</cell><cell>10</cell><cell></cell><cell></cell>
            </row>
          </tabular>
          <p>Type: <fillin characters="18"/> <m>\quad</m> Equation: <fillin characters="22"/></p>
        </statement>
        <answer>
          <p>Neither (quadratic). <m>y = n^2 + 1</m>; values 17 and 26.</p>
        </answer>
      </task>

      <task xml:id="ex-table-d">
        <statement>
          <p><em>Table D</em></p>
          <tabular halign="center" top="major" bottom="major" left="minor" right="minor">
            <row header="yes" bottom="minor">
              <cell><m>n</m></cell><cell>1</cell><cell>2</cell><cell>3</cell>
              <cell>4</cell><cell>5</cell>
            </row>
            <row>
              <cell><m>y</m></cell>
              <cell>96</cell><cell>48</cell><cell>24</cell><cell></cell><cell></cell>
            </row>
          </tabular>
          <p>Type: <fillin characters="18"/> <m>\quad</m> Equation: <fillin characters="22"/></p>
        </statement>
        <answer>
          <p>Exponential decay (ratio <m>\tfrac{1}{2}</m>).
          <m>y = 96 \cdot \left(\tfrac{1}{2}\right)^{n-1}</m>; values 12 and 6.</p>
        </answer>
      </task>

    </exercise>

  </page>

</worksheet>
